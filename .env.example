# Copy to .env and fill in. Load with:  set -a; . ./.env; set +a
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-string

# Optional. If empty, a random key is created in data/.app_secret.
APP_SECRET_KEY=

# Optional. Lets scripts and MCP clients call the chat routes and /mcp. At least 24 characters.
# This is this app's own key, not an OpenAI key.
# APP_API_KEY=

# Set to 1 when serving over HTTPS so the session cookie is HTTPS-only.
COOKIE_SECURE=0

# Optional. Where records are kept. Defaults to ./data
# GEMINI_WEBUI_DATA=/var/lib/chatgpt-webui
